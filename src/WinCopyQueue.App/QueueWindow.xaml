<Window x:Class="WinCopyQueue.QueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinCopyQueue"
        Width="500"
        Height="570"
        MinWidth="500"
        MaxWidth="500"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EAF4FF" />
            <Setter Property="Background" Value="#17375E" />
            <Setter Property="BorderBrush" Value="#315F8F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#24517F" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5DA9E9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#102D4D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="#F7112033"
            BorderBrush="#526A8BAA"
            BorderThickness="1"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.38" Color="#001020" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="20,18,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="50" Height="50" CornerRadius="12" Margin="0,0,12,0" ClipToBounds="True">
                    <Border.Background>
                        <ImageBrush ImageSource="/WinCopyQueue;component/Assets/logo-full.png"
                                    Stretch="UniformToFill"
                                    Viewbox="0.26,0,0.48,1"
                                    ViewboxUnits="RelativeToBoundingBox" />
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="WinCopyQueue" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding VersionText}" Foreground="#6F8DA7" FontSize="10" Margin="7,5,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding SummaryText}" Foreground="#9FB8CE" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="2"
                        Content="{Binding PauseButtonText}"
                        IsEnabled="{Binding PauseButtonEnabled}"
                        Click="Pause_Click"
                        Margin="10,0,8,0"
                        VerticalAlignment="Center" />
                <Button Grid.Column="3"
                        Content="—"
                        Click="Hide_Click"
                        Width="34"
                        Height="34"
                        Padding="0"
                        FontSize="16"
                        FontWeight="Bold"
                        ToolTip="{Binding [Hide]}" />
            </Grid>

            <Grid Grid.Row="1" Margin="14,0,14,0">
                <Border Visibility="{Binding EmptyVisibility}"
                        Background="#8017283A"
                        BorderBrush="#344C64"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="24">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding [EmptyTitle]}"
                                   Foreground="#EAF4FF"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding [EmptyDescription]}"
                                   Foreground="#91A9BD"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="20,8,20,0" />
                    </StackPanel>
                </Border>

                <ScrollViewer Visibility="{Binding ListVisibility}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#C9172A3E"
                                        BorderBrush="{Binding StateBrush}"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        Padding="15,13"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SessionTitle}"
                                                       Foreground="#F2F7FC"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1"
                                                    Background="{Binding StateBrush}"
                                                    CornerRadius="6"
                                                    Padding="7,3"
                                                    Margin="10,0,0,0">
                                                <TextBlock Text="{Binding StateText}"
                                                           Foreground="#07192A"
                                                           FontSize="10"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding DestinationText}"
                                                   ToolTip="{Binding DestinationPath}"
                                                   Foreground="#8FA9BF"
                                                   FontSize="11"
                                                   Margin="0,5,0,10"
                                                   TextTrimming="CharacterEllipsis" />

                                        <ProgressBar Height="7"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding Progress, Mode=OneWay}"
                                                     Foreground="#58B9F0"
                                                     Background="#243C53"
                                                     BorderThickness="0" />
                                        <Grid Margin="0,5,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SpeedText}"
                                                       Foreground="#65BCEB"
                                                       FontSize="11" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ProgressText}"
                                                       Foreground="#AFC4D6"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right" />
                                        </Grid>

                                        <TextBlock Text="{Binding CurrentFileText}"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CurrentFilePath}" />

                                        <StackPanel Visibility="{Binding UpcomingVisibility}" Margin="0,9,0,0">
                                            <TextBlock Text="{Binding NextText}" Foreground="#6F8DA7" FontSize="9" FontWeight="Bold" />
                                            <ItemsControl ItemsSource="{Binding UpcomingFiles}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   Foreground="#9DB4C8"
                                                                   FontSize="11"
                                                                   Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Grid Margin="0,11,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="{Binding ExpandButtonText}"
                                                    Click="Expand_Click"
                                                    HorizontalAlignment="Left"
                                                    Padding="10,5"
                                                    FontSize="11" />
                                            <Button Grid.Column="1"
                                                    Content="{Binding CancelButtonText}"
                                                    Visibility="{Binding CancelVisibility}"
                                                    Click="Cancel_Click"
                                                    Background="#542A35"
                                                    BorderBrush="#A94D5C"
                                                    Padding="10,5"
                                                    FontSize="11"
                                                    ToolTip="{Binding CancelToolTip}" />
                                            <Button Grid.Column="2"
                                                    Content="{Binding RemoveButtonText}"
                                                    Visibility="{Binding RemoveVisibility}"
                                                    Click="Remove_Click"
                                                    Background="#473744"
                                                    BorderBrush="#8D6172"
                                                    Margin="6,0,0,0"
                                                    Padding="10,5"
                                                    FontSize="11"
                                                    ToolTip="{Binding RemoveToolTip}" />
                                        </Grid>

                                        <Border Visibility="{Binding ExpandedVisibility}"
                                                Background="#8A0C1C2C"
                                                BorderBrush="#2B455D"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Margin="0,9,0,0"
                                                Padding="5">
                                            <ListBox ItemsSource="{Binding Files}"
                                                     MaxHeight="190"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="White"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="7,5" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Focusable" Value="False" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ToolTip="{Binding FullPath}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Width="6" Height="6" Fill="{Binding StateBrush}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding DisplayName}"
                                                                       Foreground="#C8D8E5"
                                                                       FontSize="11"
                                                                       Margin="7,0,8,0"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding StateText}"
                                                                       Foreground="{Binding StateBrush}"
                                                                       FontSize="9"
                                                                       FontWeight="Bold" />
                                                            <StackPanel Grid.Column="3"
                                                                        Grid.ColumnSpan="2"
                                                                        Orientation="Horizontal"
                                                                        Visibility="{Binding ControlsVisibility}"
                                                                        Margin="8,0,0,0">
                                                                <Button Content="{Binding PauseButtonText}"
                                                                        Click="FilePause_Click"
                                                                        Padding="6,2"
                                                                        Margin="0,0,4,0"
                                                                        FontSize="9"
                                                                        ToolTip="{Binding PauseToolTip}" />
                                                                <Button Content="{Binding CancelText}"
                                                                        Click="FileCancel_Click"
                                                                        Padding="6,2"
                                                                        Margin="0"
                                                                        FontSize="9"
                                                                        Background="#542A35"
                                                                        BorderBrush="#A94D5C"
                                                                        ToolTip="{Binding CancelToolTip}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <StackPanel Grid.Row="2" Margin="18,9,18,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding [ClearCompleted]}"
                            Click="ClearCompleted_Click"
                            IsEnabled="{Binding CanClearCompleted}"
                            Padding="9,5"
                            FontSize="10" />
                    <CheckBox Grid.Column="1"
                              Content="{Binding [Verify]}"
                              IsChecked="{Binding VerifyIntegrity}"
                              ToolTip="{Binding [VerifyTip]}"
                              Foreground="#AFC4D6"
                              VerticalAlignment="Center"
                              Margin="12,0" />
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="DisplayName"
                              ToolTip="{Binding [Language]}"
                              Width="105"
                              Height="27" />
                </Grid>
                <TextBlock Text="{Binding [Footer]}"
                           Foreground="#718CA3"
                           FontSize="10"
                           TextAlignment="Center"
                           Margin="2,8,2,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
